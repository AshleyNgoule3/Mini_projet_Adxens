# PostgreSQL (service "db" de docker-compose.yml)
POSTGRES_DB=gestion_employes
POSTGRES_USER=gestion_employes
POSTGRES_PASSWORD=changeme

# Base de donnees cote backend (backend/src/main/resources/application.yml).
# Avec docker-compose, DB_URL pointe vers le service "db" ; en execution
# locale hors conteneur, utiliser localhost.
DB_URL=jdbc:postgresql://db:5432/gestion_employes
DB_USERNAME=gestion_employes
DB_PASSWORD=changeme

# Profil Spring actif pour le backend. "local" charge en plus le jeu de
# donnees de demonstration (backend/src/main/resources/db/seed).
SPRING_PROFILES_ACTIVE=local

# Origine unique autorisee en CORS par le backend. N'intervient que pour un
# appel hors proxy (ex. VITE_API_URL absolu ci-dessous) : le parcours nominal
# passe par le proxy /api du serveur de dev Vite, meme origine, donc pas de
# CORS implique.
APP_CORS_ORIGIN=http://localhost:5173

# Optionnel : le frontend appelle /api (meme origine que la page) par defaut,
# resolu par le proxy Vite en dev (voir frontend/vite.config.ts). Ne definir
# VITE_API_URL que pour pointer ponctuellement vers une API sur une autre
# origine ; laissee vide, elle n'est pas necessaire au fonctionnement normal
# et n'est jamais figee dans le bundle de production par defaut.
# VITE_API_URL=http://localhost:8080/api
# Ports publies sur la machine hote (interne inchange)
FRONTEND_HOST_PORT=8090
BACKEND_HOST_PORT=18080
DB_HOST_PORT=55432
